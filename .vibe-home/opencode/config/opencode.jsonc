{
  "$schema": "https://opencode.ai/config.json",
  "skills": [".agents/skills"],
  "mcp": {
    // VSCode MCP Server (Semantic Workbench Team) example
    "vscode": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "http://host.docker.internal:6010/sse",
        "--transport",
        "sse-only",
        "--allow-http"
      ],
      "enabled": false
    },
    // Official JetBrains IntelliJ MCP Server (built-in since 2025.2)
    // Prefer streamable HTTP; set IDEA_MCP_STREAM_URL / IDEA_MCP_PROJECT_PATH in env
    "intellij": {
      "type": "remote",
      "url": "{env:IDEA_MCP_STREAM_URL}",
      "enabled": true,
      "headers": {
        "IJ_MCP_SERVER_PROJECT_PATH": "{env:IDEA_MCP_PROJECT_PATH}"
      }
    },
    // SSE fallback (legacy transport) — enable if stream is unavailable
    "intellij-sse": {
      "type": "remote",
      "url": "{env:IDEA_MCP_URL}",
      "enabled": false,
      "headers": {
        "IJ_MCP_SERVER_PROJECT_PATH": "{env:IDEA_MCP_PROJECT_PATH}"
      }
    }
  }
}
