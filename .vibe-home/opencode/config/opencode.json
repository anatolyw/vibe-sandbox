{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "vscode": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "mcp-remote",
        "http://host.docker.internal:6010/sse",
        "--transport",
        "sse-only",
        "--allow-http"
      ],
      "enabled": true
    }
  }
}