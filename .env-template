# === Project ===
HOST_PROJECT_DIR=/absolute/path/to/your/project   # e.g. /Users/you/code/my-ios-app
CONTAINER_WORK_DIR=/workspace

# === Host paths (for optional mounts) ===
HOST_HOME=${HOME}                    # usually /Users/you or /home/you
HOST_SSH_DIR=${HOME}/.ssh
HOST_NPM_CACHE=${HOME}/.npm
#HOST_PNPM_STORE=${HOME}/.local/share/pnpm/store   # optional, comment out if unused
HOST_GRADLE_DIR=${HOME}/.gradle
HOST_M2_DIR=${HOME}/.m2

# Run container as your host user (avoids root-owned files)
# On macOS these are normally already set; on Linux you may need to export them
# Run as the image’s built-in "node" user (uid 1000)
UID=${UID:-1000}
GID=${GID:-1000}

# === LLM providers (pick what you use) ===
MISTRAL_API_KEY=your_mistral_key_here
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=

# === IntelliJ CE MCP (host) ===
# After enabling MCP Server in IntelliJ: Settings → Tools → MCP Server
# Click "Copy SSE Config" or "Copy HTTP Stream Config" and note the port
IDEA_MCP_PORT=64342
IDEA_MCP_HOST=host.docker.internal
# Optional header some JetBrains setups use
IDEA_MCP_PROJECT_PATH=${HOST_PROJECT_DIR}

# === VSCode MCP Server (Semantic Workbench Team) ===
# Extension: SemanticWorkbenchTeam.mcp-server-vscode
# Default port is 6010. Change via Command Palette → "Set MCP Server Port"
# or Settings → search "mcpServer.port"
VSCODE_MCP_PORT=6010
VSCODE_MCP_HOST=host.docker.internal

# === Optional extra MCP endpoints (comma-separated or leave empty) ===
# Example: http://host.docker.internal:3001/sse,http://host.docker.internal:3002/mcp
EXTRA_MCP_URLS=
