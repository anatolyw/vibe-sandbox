# === Project ===
HOST_PROJECT_DIR=/absolute/path/to/your/project   # e.g. /Users/you/code/my-ios-app
CONTAINER_WORK_DIR=/workspace

# === Host paths (for optional mounts) ===
HOST_HOME=${HOME}                    # usually /Users/you or /home/you
HOST_SSH_DIR=${HOME}/.ssh
HOST_NPM_CACHE=${HOME}/.npm
#HOST_PNPM_STORE=${HOME}/.local/share/pnpm/store   # optional, comment out if unused
HOST_GRADLE_DIR=${HOME}/.gradle
HOST_M2_DIR=${HOME}/.m2

# Oh My Zsh from the host
HOST_OH_MY_ZSH=${HOME}/.oh-my-zsh
HOST_ZSHRC=${HOME}/.zshrc

# Container process user.
# Default 1000 matches the image's "node" user (recommended).
# On Linux, set these to your host uid/gid if you need bind-mounted files
# owned by your host user:  export UID=$(id -u) GID=$(id -g)
UID=${UID:-1000}
GID=${GID:-1000}

# === LLM providers (pick what you use) ===
MISTRAL_API_KEY=your_mistral_key_here
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
XAI_API_KEY=
HETZNER_API_KEY=your_hetzner_key_here
HETZNER_API_BASE_URL=https://inference.hetzner.com/api/v1

# === IntelliJ CE MCP (host) — official JetBrains MCP Server (IDEA 2025.2+) ===
# Settings → Tools → MCP Server → Enable MCP Server
# Prefer HTTP Stream; SSE is legacy fallback
IDEA_MCP_PORT=64343 # Proxy port for IntelliJ MCP Server 64342->64343
IDEA_MCP_HOST=host.docker.internal
IDEA_MCP_PROJECT_PATH=${HOST_PROJECT_DIR}
IDEA_MCP_STREAM_URL=http://${IDEA_MCP_HOST}:${IDEA_MCP_PORT}/stream
IDEA_MCP_URL=http://${IDEA_MCP_HOST}:${IDEA_MCP_PORT}/sse
# Optional JSON form (some clients expect this exact header bag)
IDEA_MCP_HEADERS={"IJ_MCP_SERVER_PROJECT_PATH":"${IDEA_MCP_PROJECT_PATH}"}

# === VSCode MCP Server (Semantic Workbench Team) ===
# Extension: SemanticWorkbenchTeam.mcp-server-vscode
# Default port is 6010. Change via Command Palette → "Set MCP Server Port"
# or Settings → search "mcpServer.port"
VSCODE_MCP_PORT=6010
VSCODE_MCP_HOST=host.docker.internal
VSCODE_MCP_URL=http://${VSCODE_MCP_HOST}:${VSCODE_MCP_PORT}/sse
VSCODE_MCP_STREAM_URL=http://${VSCODE_MCP_HOST}:${VSCODE_MCP_PORT}/sse

# === Optional extra MCP endpoints (comma-separated or leave empty) ===
# Example: http://host.docker.internal:3001/sse,http://host.docker.internal:3002/mcp
EXTRA_MCP_URLS=
